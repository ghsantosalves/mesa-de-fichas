  "applications": {
    "zotero": {
      "id": "mesa-de-fichas@ghsantosalves.github.io",
      "update_url": "https://ghsantosalves.github.io/mesa-de-fichas/updates.json",
      "strict_min_version": "6.999",
      "strict_max_version": "10.*"
    }
  }
